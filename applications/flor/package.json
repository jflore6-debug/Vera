{
  "name": "flor",
  "private": true,
  "version": "0.0.0",
  "description": "A standalone PowerPoint editor with a slide library and full edit history.",
  "author": "Flor",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron": "electron .",
    "desktop:mac": "npm run build && electron-builder --mac zip --publish=never",
    "desktop:win": "npm run build && electron-builder --win nsis --publish=never",
    "desktop:linux": "npm run build && electron-builder --linux AppImage --publish=never"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "immer": "^11.1.18",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-rnd": "^10.5.3",
    "uuid": "^14.0.2",
    "zundo": "^2.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.79.0",
    "png2icons": "^2.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  },
  "build": {
    "appId": "app.flor.editor",
    "productName": "Flor",
    "copyright": "Flor",
    "publish": null,
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!node_modules/**/*"
    ],
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Office"
    }
  }
}
